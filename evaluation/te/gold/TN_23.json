                    },
                    {
                        "id": "e20",
                        "description": "wedding ring and my other diamond ring"
                    },
                    {
                        "id": "e21",
                        "description": "rest and residue of my estate, whether it be real, personal or mixed property"
                    },
                    {
                        "id": "e22",
                        "description": "[Person-2] or [Person-3]'s one-half share of my remaining estate"
                    }
                ],
                "condition": [
                    {
                        "id": "e23",
                        "text": "if they survive me"
                    },
                    {
                        "id": "e24",
                        "text": "I direct that the sums being paid to my grandchildren, [Person-8] and [Person-9], be held in trust for their future use and benefit until they reach the age of twenty-five (25)."
                    },
                    {
                        "id": "e25",
                        "text": "I direct that [Person-3] and wife, [Person-10], serve as Co-Trustees without bond"
                    },
                    {
                        "id": "e26",
                        "text": "to be held in trust for his future use and benefit until he reaches the age of twenty-five (25)"
                    },
                    {
                        "id": "e27",
                        "text": "I appoint his mother, [Person-7], to serve as Trustee without bond."
                    },
                    {
                        "id": "e28",
                        "text": "if they survive me"
                    },
                    {
                        "id": "e29",
                        "text": "if any of my grandchildren are minors, I direct that their parent or guardian shall have the right to choose on their behalf."
                    },
                    {
                        "id": "e30",
                        "text": "I specifically direct that the items of furniture or personal property selected by each grandchild or their representative shall be of approximately equal appraised value"
                    },
                    {
                        "id": "e31",
                        "text": "if any recipient should select an item that is greater in value than that selected by any of the other beneficiaries under this paragraph, then that beneficiary shall have the right to choose additional items so as to approximately equalize the value of furniture or personal items being received by each grandchild."
                    },
                    {
                        "id": "e32",
                        "text": "equally"
                    },
                    {
                        "id": "e33",
                        "text": "if they survive me"
                    },
                    {
                        "id": "e34",
                        "text": "If either one of my sons should predecease me"
                    },
                    {
                        "id": "e35",
                        "text": "in equal shares"
                    }
                ]
            }
