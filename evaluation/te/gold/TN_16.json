                "condition": [
                    {
                        "id": "e9",
                        "text": "If my husband and I should die simultaneously, or my husband predecease me"
                    },
                    {
                        "id": "e10",
                        "text": "equally, share and share alike"
                    },
                    {
                        "id": "e11",
                        "text": "If either or both of my children are under age 21 at the time of our death, I direct that [Person-5] be appointed Trustee and Guardian of all property bequeathed, given and devised to my children, that said property be held in trusts established by him for each child, and managed and used solely for the benefit of my children."
                    },
                    {
                        "id": "e12",
                        "text": "I direct that my Trustee pay to or on behalf of my children so much of the income and principal in such trusts as my Trustee in his sole and absolute discretion may determine is necessary for health, education and welfare or other needs of my children."
                    }
                ]
            }
